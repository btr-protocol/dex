{
  "name": "@btr/dex-front",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run build:search-index && bun run build:markdown && vite build",
    "build:search-index": "bun ../scripts/build-search-index.ts",
    "build:markdown": "bun ../scripts/precompile-markdown.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pwa-assets": "rm -rf public/pwa && pwa-asset-generator public/brand/logo-b.svg public/pwa --padding '30%' --background '#0a0a0a' --type png"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@preact/signals": "^2.5.1",
    "@tanstack/react-query": "^5.90.12",
    "@walletconnect/sign-client": "^2.23.0",
    "lightweight-charts": "^5.0.9",
    "minisearch": "^7.2.0",
    "preact": "^10.22.0",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@preact/preset-vite": "^2.8.2",
    "@types/node": "^20.14.2",
    "@types/prismjs": "^1.26.5",
    "@types/qrcode": "^1.5.6",
    "@unocss/preset-icons": "^66.5.10",
    "@unocss/preset-wind": "^66.5.10",
    "@vitejs/plugin-react": "^4.3.5",
    "asciimath2ml": "^1.0.7",
    "markdown-wasm": "^1.2.0",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "playwright": "^1.57.0",
    "prismjs": "^1.30.0",
    "pwa-asset-generator": "^8.1.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^5.4.5",
    "unocss": "^66.5.10",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^1.1.0",
    "vite-plugin-wasm": "^3.5.0",
    "workbox-window": "^7.3.0"
  }
}
