{
  "name": "@btr/dex-front",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run build:search-index && bun run build:markdown && vite build",
    "build:search-index": "bun ../scripts/build-search-index.ts",
    "build:markdown": "bun ../scripts/precompile-markdown.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pwa-assets": "rm -rf public/pwa && pwa-asset-generator public/brand/logo-b.svg public/pwa --padding '30%' --background '#0a0a0a' --type png"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@preact/signals": "^2.5.1",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@tanstack/react-query": "^5.90.12",
    "@walletconnect/sign-client": "^2.23.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.0.9",
    "lucide-react": "^0.536.0",
    "minisearch": "^7.2.0",
    "preact": "^10.22.0",
    "react-chartjs-2": "^5.3.1",
    "tailwind-merge": "^3.4.0",
    "technicalindicators": "^3.1.0",
    "viem": "2.x",
    "wagmi": "2.x"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.8.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.14.2",
    "@types/prismjs": "^1.26.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.19",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.5",
    "asciimath2ml": "^1.0.7",
    "autoprefixer": "^10.4.21",
    "happy-dom": "^20.0.11",
    "markdown-wasm": "^1.2.0",
    "marked": "^17.0.1",
    "mermaid": "^11.12.2",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "prismjs": "^1.30.0",
    "pwa-asset-generator": "^8.1.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^1.1.0",
    "vite-plugin-wasm": "^3.5.0",
    "workbox-window": "^7.3.0"
  }
}
