VITE_WC_PROJECT_ID=your_walletconnect_project_id

# Archivist API URL (defaults to http://localhost:4001 if not set)
VITE_ARCHIVIST_API=http://localhost:4001

# Auth API URL (used for guarded launch)
VITE_AUTH_API=http://localhost:4001

# Guarded launch mode (true to require invite code)
VITE_GUARDED=false
