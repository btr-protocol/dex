precision highp float;

uniform vec2  iResolution;
uniform float iTime;
uniform float uStrokeThickness;
uniform float uLineSpacing;

// --- Fixed camera basis (camera at (0,10,10) looking at (0,0,0)) ---
const vec3 camPos   = vec3(0.0, 10.0, 10.0);
const vec3 camFwd   = vec3(0.0, -0.707106, -0.707106);
const vec3 camUp    = vec3(0.0,  0.707106, -0.707106);
const vec3 camRight = vec3(1.0,  0.0,       0.0);

// 1.0 / tan(60° / 2). Controls perspective strength.
const float FOV_SCALE = 1.73205;

const float PI = 3.14159265;

// Height function over x,z
float getHeight(vec3 p) {
    float zTerm = p.z * 0.5 + iTime;
    float s = sin(zTerm);

    float x = clamp(p.x + s * 3.0, -PI, PI);
    float c = cos(x);

    float v = c * 0.5 + 0.5;  // remap to [0,1]
    v *= v;                   // v^2
    v *= v;                   // v^4

    return v * s * 3.0;
}

// Surface raymarch: y = getHeight(x,z)
float raymarch(vec3 ro, vec3 rd) {
    float t = 0.0;
    for (int i = 0; i < 32; ++i) {
        vec3 p = ro + rd * t;
        float h = getHeight(p);
        float d = (p.y - h) * 0.6;

        if (d < 0.002) {
            // Small refinement to remove notches at extrema
            float t0 = t - 0.003;  // slightly before
            float t1 = t + 0.003;  // slightly after
            for (int j = 0; j < 2; ++j) {
                float tm = 0.5 * (t0 + t1);
                vec3 pm = ro + rd * tm;
                float hm = getHeight(pm);
                float dm = pm.y - hm;
                if (dm > 0.0) {
                    t0 = tm;
                } else {
                    t1 = tm;
                }
            }
            return 0.5 * (t0 + t1);
        }

        if (t > 50.0) break;
        t += d;
    }
    return -1.0;
}

void main() {
    // Normalized view plane coordinates (account for aspect via divide by height)
    vec2 uv = (gl_FragCoord.xy - 0.5 * iResolution.xy) / iResolution.y;

    // Build ray direction from precomputed basis, then normalize once
    vec3 rayDir = normalize(uv.x * camRight + uv.y * camUp + FOV_SCALE * camFwd);

    float t = raymarch(camPos, rayDir);
    vec3 col = vec3(0.0);

    if (t > 0.0) {
        vec3 p = camPos + rayDir * t;

        // Stripe pattern along Z using inexpensive 1D distance from line centers
        float spacing = max(uLineSpacing, 0.001);
        float halfSpacing = 0.5 * spacing;
        float distFromLineCenter = abs(mod(p.z, spacing) - halfSpacing);

        // Visual stroke width
        float width = max(0.002, uStrokeThickness);

        // Soft edge for the line (small AA band)
        float aa = 0.005;
        float mask = 1.0 - smoothstep(width, width + aa, distFromLineCenter);

        if (mask > 0.0) {
            // Depth-based darkening: pow(depth,1.5) ≈ depth^2 for cheapness
            float depth = clamp(t * (1.0 / 15.0), 0.0, 1.0);
            float strokeDarkness = mix(0.4, 0.05, depth * depth);

            col = vec3(strokeDarkness * mask);
        }
    }

    gl_FragColor = vec4(col, 1.0);
}
