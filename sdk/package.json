{
  "name": "@btr/sdk",
  "version": "1.0.0",
  "description": "Modular SDK for BTR DEX - supports AMM flows, oracles, and guardians",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./abis": {
      "types": "./src/abis/index.ts",
      "default": "./src/abis/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./src/utils/index.ts"
    },
    "./utils/logger": {
      "types": "./src/utils/logger.ts",
      "default": "./src/utils/logger.ts"
    },
    "./guardians": {
      "types": "./src/guardians/index.ts",
      "default": "./src/guardians/index.ts"
    },
    "./oracles": {
      "types": "./src/oracles/index.ts",
      "default": "./src/oracles/index.ts"
    },
    "./flows": {
      "types": "./src/flows/index.ts",
      "default": "./src/flows/index.ts"
    },
    "./pool": {
      "types": "./src/pool/index.ts",
      "default": "./src/pool/index.ts"
    },
    "./eth": {
      "types": "./src/eth/index.ts",
      "default": "./src/eth/index.ts"
    }
  },
  "scripts": {
    "typecheck": "bunx tsgo -p tsconfig.json --noEmit",
    "typecheck:watch": "bunx tsgo -p tsconfig.json --watch --noEmit",
    "build": "bun build ./src/index.ts --outdir ./dist --target node",
    "lint": "oxlint src",
    "fmt": "oxlint --fix src",
    "test": "bun test"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.10.0",
    "@typescript/native-preview": "^7.0.0-dev.20251227.1",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "dex",
    "amm",
    "defi",
    "oracle",
    "circuit-breaker",
    "ethereum"
  ],
  "sideEffects": false
}
