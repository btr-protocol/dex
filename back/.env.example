# key addresses
DEPLOYER=
TREASURY=
DEPLOYER_PK=

# Do not commit this file to version control
CREATEX=0xba5Ed099633D3B313e4D5F7bdc1305d3c28ba5Ed
USE_CREATE3=true

# Service Ports
# Each service checks its specific env var first, then PORT, then its default
FRONTEND_PORT=3000
COLLECTOR_PORT=3001
AGENTS_PORT=4001
TEI_PORT=8080

# Generic PORT fallback (used if specific port not set)
PORT=

# API Server Configuration
GENESIS_INVITE_CODE=
JWT_SECRET=
ADMIN_WALLETS=
DISCLAIMER_EXPIRY_DAYS=30
CORS_ENABLED=true
RATE_LIMIT_PER_SESSION=60

# ZAI Configuration
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_API_KEY=
ZAI_MODEL_ENHANCEMENT=glm-4.5-airx
ZAI_MODEL_REASONING=glm-4.7

# TEI & Hugging Face Configuration
HF_TOKEN=
TEI_URL=http://localhost
# EmbeddingGemma ONNX: 768D embeddings, SOTA model, quantized for CPU efficiency
# Uses cloned local directory for reliability (avoids LFS pointer issues)
# Alternative: BAAI/bge-base-en-v1.5 (768D, no token required)
TEI_MODEL=onnx-community/embeddinggemma-300m-ONNX
TEI_GPU=false

# Logging
LOG_LEVEL=info
NODE_ENV=development

# chains rpcs
HTTP_RPCS_1=rpc.ankr.com/eth,eth.llamarpc.com,eth-mainnet.public.blastapi.io,endpoints.omniatech.io/v1/eth/mainnet/public,1rpc.io/eth,cloudflare-eth.com,ethereum.blockpi.network/v1/rpc/public,eth.drpc.org
