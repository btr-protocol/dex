import { getStorage } from '../core/storage.js';
import type { AgentConfig, KnowledgeChunk, FileDigest } from '../core/types.js';
import { getEmbeddingProvider } from '../core/models.js';
import { getVectorDB } from '../core/vector.js';
import { glob } from 'glob';
import { createHash } from 'crypto';


const DIGEST_CACHE_PATH = `${process.cwd()}/back/agents/.data/file-digests.json`;

async function loadDigestCache(): Promise<Map<string, FileDigest>> {
  try {
    const content = await Bun.file(DIGEST_CACHE_PATH).text();
    const data = JSON.parse(content) as Record<string, FileDigest>;
    return new Map(Object.entries(data));
  } catch {
    return new Map();
  }
}

async function saveDigestCache(cache: Map<string, FileDigest>): Promise<void> {
  const data = Object.fromEntries(cache.entries());
  await Bun.write(DIGEST_CACHE_PATH, JSON.stringify(data, null, 2));
}

async function computeFileDigest(filePath: string): Promise<string> {
  const content = await Bun.file(filePath).text();
  return createHash('sha256').update(content).digest('hex');
}

async function getFileInfo(filePath: string): Promise<{ size: number; lastModified: number }> {
  const file = Bun.file(filePath);
  return {
    size: file.size,
    lastModified: file.lastModified
  };
}

export async function indexKnowledge(agentId: string, forceReindex = false): Promise<void> {
  const storage = await getStorage();
  const config = storage.getAgent(agentId);

  if (!config) {
    throw new Error(`Agent ${agentId} not found`);
  }

  log(`Indexing knowledge for ${agentId}${forceReindex ? ' (forced)' : ''}...`);

  // Load existing digest cache
  const digestCache = await loadDigestCache();
  const newDigestCache = new Map<string, FileDigest>();

  const chunks: KnowledgeChunk[] = [];
  const allFiles: string[] = [];

  for (const includePattern of config.knowledge.include) {
    const files = await glob(includePattern, {
      cwd: process.cwd(),
      ignore: config.knowledge.exclude,
      absolute: true
    });

    log(`Found ${files.length} files matching pattern: ${includePattern}`);
    allFiles.push(...files);
  }

  log(`Processing ${allFiles.length} files...`);

  let skippedCount = 0;
  let processedCount = 0;

  for (let fileIndex = 0; fileIndex < allFiles.length; fileIndex++) {
    const filePath = allFiles[fileIndex]!;
    const progress = ((fileIndex + 1) / allFiles.length * 100).toFixed(1);
    const fileName = filePath.split('/').pop() || filePath;

    // Compute file digest
    const currentDigest = await computeFileDigest(filePath);
    const fileInfo = await getFileInfo(filePath);
    const cachedDigest = digestCache.get(filePath);

    // Skip if file hasn't changed (unless force reindex)
    if (!forceReindex && cachedDigest && cachedDigest.digest === currentDigest) {
      skippedCount++;
      newDigestCache.set(filePath, cachedDigest);
      log(`[${progress}%] Skipped ${fileName} (unchanged)`);
      continue;
    }

    // File changed or new, process it
    const fileChunks = await chunkFile(filePath, config, currentDigest);
    chunks.push(...fileChunks);
    processedCount++;

    // Update digest cache
    newDigestCache.set(filePath, {
      path: filePath,
      digest: currentDigest,
      size: fileInfo.size,
      lastModified: fileInfo.lastModified,
      chunkCount: fileChunks.length
    });

    log(`[${progress}%] Processed ${fileName} (${fileChunks.length} chunks)`);
  }

  log(`Summary: ${processedCount} files processed, ${skippedCount} files skipped (unchanged)`);

  if (chunks.length > 0) {
    log(`Generating embeddings for ${chunks.length} chunks...`);
    const provider = await getEmbeddingProvider();

    const texts = chunks.map(c => c.text);
    const embeddings = await provider.generateEmbeddings(texts);

    for (let i = 0; i < chunks.length; i++) {
      const embedding = embeddings[i];
      if (embedding) {
        chunks[i]!.vector = embedding;
      }
    }

    await getVectorDB().addChunks(chunks);
    log(`✅ Successfully indexed ${chunks.length} chunks for ${agentId}`);
  } else {
    log('No new or changed files to index');
  }

  // Save updated digest cache
  await saveDigestCache(newDigestCache);
  log('Digest cache updated');
}

async function chunkFile(filePath: string, config: AgentConfig, fileDigest: string): Promise<KnowledgeChunk[]> {
  try {
    const content = await Bun.file(filePath).text();
    const { chunkSize, overlap } = config.chunking;
    const ext = filePath.split('.').pop() || '';

    const chunks: KnowledgeChunk[] = [];
    let offset = 0;

    while (offset < content.length) {
      const end = Math.min(offset + chunkSize, content.length);
      const chunkText = content.slice(offset, end);

      if (chunkText.trim().length >= config.chunking.minChunkSize) {
        chunks.push({
          id: 0,
          vector: [],
          text: chunkText.trim(),
          sourceType: inferSourceType(ext),
          sourceRef: filePath,
          metadata: {
            language: inferLanguage(ext),
            section: extractSection(content, offset)
          },
          indexedAt: new Date().toISOString(),
          fileDigest
        });
      }

      if (end >= content.length) {
        break;
      }

      offset += chunkSize - overlap;
    }

    return chunks;
  } catch (error) {
    log(`Error chunking ${filePath}: ${error}`);
    return [];
  }
}

function inferSourceType(ext: string): 'code' | 'doc' | 'markdown' {
  if (['ts', 'tsx', 'js', 'jsx', 'sol'].includes(ext)) return 'code';
  if (['md'].includes(ext)) return 'markdown';
  return 'doc';
}

function inferLanguage(ext: string): string | undefined {
  const langMap: Record<string, string> = {
    'ts': 'typescript',
    'tsx': 'typescript',
    'sol': 'solidity',
    'js': 'javascript',
    'md': 'markdown'
  };
  return langMap[ext];
}

function extractSection(content: string, offset: number): string | undefined {
  const before = content.slice(Math.max(0, offset - 100), offset);
  const match = before.match(/#{1,3}\s+(.+)/g);
  return match ? match[match.length - 1].slice(2).trim() : undefined;
}
