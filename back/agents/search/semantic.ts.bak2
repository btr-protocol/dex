import type { SearchResult, AgentConfig } from '../core/types.js';
import { getEmbeddingProvider } from '../core/models.js';


/**
 * Vector database interface
 */
interface VectorDatabase {
  search(embedding: number[], k: number): Promise<SearchResult[]>;
  addChunks?(chunks: any[]): Promise<void>;
}

/**
 * Semantic search result with similarity metadata
 */
export interface SemanticSearchResult extends SearchResult {
  /** Cosine similarity (0-1, higher is better) */
  similarity: number;
  /** Distance metric (lower is better, depends on backend) */
  distance?: number;
}

/**
 * Configuration for semantic search
 */
export interface SemanticSearchConfig {
  /** Maximum number of results to return */
  maxResults: number;
  /** Minimum similarity threshold (0-1) */
  minSimilarity: number;
  /** Whether to include metadata in results */
  includeMetadata: boolean;
}

/**
 * In-memory vector search fallback when LanceDB is unavailable.
 */
class InMemoryVectorDB implements VectorDatabase {
  private chunks: Array<{ vector: number[]; data: SearchResult }> = [];

  async addChunks(chunks: any[]): Promise<void> {
    // Not implemented for in-memory fallback
  }

  async search(_embedding: number[], k: number): Promise<SearchResult[]> {
    log('In-memory vector DB not fully implemented, returning empty results');
    return [];
  }
}

/**
 * LanceDB adapter for vector similarity search
 */
class LanceDBAdapter implements VectorDatabase {
  private db: any = null;
  private dbPath: string;
  private tableName: string;
  private embeddingProvider: any = null;
  private tableExists: boolean = false;

  constructor(dbPath: string, tableName: string = 'knowledge') {
    this.dbPath = dbPath;
    this.tableName = tableName;
  }

  private async getClient() {
    if (!this.db) {
      const { connect } = await import('@lancedb/lancedb');
      this.db = await connect(this.dbPath);
    }
    return this.db;
  }

  private async getEmbeddingProvider() {
    if (!this.embeddingProvider) {
      this.embeddingProvider = await getEmbeddingProvider();
    }
    return this.embeddingProvider;
  }

  async checkTableExists(): Promise<boolean> {
    try {
      const client = await this.getClient();
      const tables = await client.tableNames();
      this.tableExists = tables.includes(this.tableName);
      return this.tableExists;
    } catch {
      this.tableExists = false;
      return false;
    }
  }

  async search(embedding: number[], k: number): Promise<SearchResult[]> {
    try {
      const client = await this.getClient();

      // Check if table exists first
      if (!this.tableExists) {
        const exists = await this.checkTableExists();
        if (!exists) {
          log(`Table "${this.tableName}" not found in LanceDB`);
          return [];
        }
      }

      const table = await client.openTable(this.tableName);
      const results = await table.vectorSearch(embedding).limit(k).toArray();

      return results.map((r: any) => ({
        content: r.text,
        sourceType: r.sourceType,
        sourceRef: r.sourceRef,
        metadata: JSON.parse(r.metadata || '{}'),
        score: 1 - r._distance,  // Convert distance to similarity
        similarity: 1 - r._distance,
        distance: r._distance
      }));
    } catch (error) {
      log(`LanceDB search error: ${error}`);
      return [];
    }
  }

  async addChunks(chunks: any[]): Promise<void> {
    // Handled by the indexing system
  }
}

/**
 * Semantic (RAG) search using vector embeddings.
 */
export async function semanticSearch(
  searchString: string,
  config?: AgentConfig,
  searchConfig?: Partial<SemanticSearchConfig>
): Promise<SearchResult[]> {
  const maxResults = searchConfig?.maxResults ?? config?.retrieval?.maxResults ?? 15;
  const minSimilarity = searchConfig?.minSimilarity ?? 0.1;

  log(`Semantic search for: "${searchString.slice(0, 100)}..." (max: ${maxResults}, min similarity: ${minSimilarity})`);

  try {
    // Get embedding provider
    const embeddingProvider = await getEmbeddingProvider();

    // Generate query embedding
    const embeddings = await embeddingProvider.generateEmbeddings([searchString]);
    const queryEmbedding = embeddings[0];

    if (!queryEmbedding || queryEmbedding.length === 0) {
      log('Failed to generate query embedding');
      return [];
    }

    log(`Generated query embedding (${queryEmbedding.length}D)`);

    // Initialize vector database
    const dbPath = `${process.cwd()}/back/agents/.data/lancedb`;
    const vectorDB = new LanceDBAdapter(dbPath, 'knowledge');

    // Perform similarity search
    const results = await vectorDB.search(queryEmbedding, maxResults);

    // Filter by similarity threshold
    const filteredResults = results.filter(r => r.score >= minSimilarity);

    log(`Semantic search complete: ${filteredResults.length} results (top similarity: ${results[0]?.score.toFixed(3) || 'N/A'})`);

    return filteredResults;
  } catch (error) {
    log(`Semantic search failed: ${error}`);
    return [];
  }
}

/**
 * Generate embeddings for a batch of text chunks.
 */
export async function generateChunkEmbeddings(texts: string[]): Promise<number[][]> {
  const embeddingProvider = await getEmbeddingProvider();
  return await embeddingProvider.generateEmbeddings(texts);
}

/**
 * Calculate cosine similarity between two vectors.
 */
export function cosineSimilarity(a: number[], b: number[]): number {
  if (a.length !== b.length) {
    throw new Error('Vector dimensions must match');
  }

  let dotProduct = 0;
  let normA = 0;
  let normB = 0;

  for (let i = 0; i < a.length; i++) {
    dotProduct += a[i] * b[i];
    normA += a[i] * a[i];
    normB += b[i] * b[i];
  }

  return dotProduct / (Math.sqrt(normA) * Math.sqrt(normB));
}

/**
 * Check if the vector database is available and populated.
 */
export async function checkVectorDBAvailability(): Promise<{
  available: boolean;
  tableExists: boolean;
  chunkCount?: number;
}> {
  try {
    const { connect } = await import('@lancedb/lancedb');
    const dbPath = `${process.cwd()}/back/agents/.data/lancedb`;
    const db = await connect(dbPath);
    const tables = await db.tableNames();
    const tableName = 'knowledge';
    const tableExists = tables.includes(tableName);

    if (!tableExists) {
      return { available: true, tableExists: false };
    }

    // Use length() instead of count() to check if table has data
    const table = await db.openTable(tableName);

    // Try to get the length - if table is empty this should be 0
    const chunkCount = await table.length || 0;

    return {
      available: true,
      tableExists: true,
      chunkCount
    };
  } catch (error) {
    log(`Vector DB availability check failed: ${error}`);
    return { available: false, tableExists: false };
  }
}
