{
  "name": "@btr/agents",
  "version": "0.1.0",
  "description": "Generic AI agent framework with hybrid RAG+fuzzy search and context management",
  "type": "module",
  "main": "core/server.ts",
  "scripts": {
    "dev": "bun --watch core/server.ts",
    "start": "bun core/server.ts",
    "typecheck": "bunx tsgo -p tsconfig.json --noEmit",
    "typecheck:watch": "bunx tsgo -p tsconfig.json --watch --noEmit",
    "lint": "oxlint core search",
    "fmt": "oxlint --fix core search"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.22.3",
    "dotenv": "^16.4.7",
    "glob": "^11.0.3",
    "openai": "^5.11.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
