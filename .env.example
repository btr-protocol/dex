# BTR DEX contracts deployment env template
# For evm/ Solidity deploy scripts + keepers.
# Copy → .env, fill in values, NEVER commit secrets.

# ─── Deployer ───────────────────────────────────────────────────────────────
DEPLOYER=
TREASURY=
DEPLOYER_PK=

# ─── CREATE3 deterministic deployment ───────────────────────────────────────
# Cross-chain identical addresses via CreateX factory.
CREATEX=0xba5Ed099633D3B313e4D5F7bdc1305d3c28ba5Ed
USE_CREATE3=true

# ─── Chain RPCs (subset — keepers consume these) ────────────────────────────
# Full RPC list lives in back/.env.example (for collector/swap/agents).
HTTP_RPCS_1=rpc.ankr.com/eth,eth.llamarpc.com
HTTP_RPCS_8453=mainnet.base.org,base.llamarpc.com
HTTP_RPCS_42161=arb1.arbitrum.io/rpc,arbitrum.llamarpc.com
