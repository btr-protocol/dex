# Environment Variables Template
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────────────────────
# Deployment Configuration
# ─────────────────────────────────────────────────────────────

# Deployer address (used for CREATE3 deterministic deployments)
# This address determines all deterministic contract addresses via salts
DEPLOYER=0x0a37aEc263CbA0aaBC09Bac56A0F2074a22E69A3

# Treasury address (can be same as deployer)
TREASURY=0x0a37aEc263CbA0aaBC09Bac56A0F2074a22E69A3

# CreateX factory contract address (available on all chains)
CREATEX=0xba5Ed099633D3B313e4D5F7bdc1305d3c28ba5Ed

# ─────────────────────────────────────────────────────────────
# DEPLOYER PRIVATE KEY - SECURITY WARNING
# ─────────────────────────────────────────────────────────────
# DO NOT commit your private key to version control
# Use one of these methods instead:
# 1. Environment variable: DEPLOYER_PK=0x... bun run dev
# 2. Secrets manager: AWS Secrets Manager, GCP Secret Manager, Hashicorp Vault
# 3. Local .env.local (not tracked by git)

# Set via environment variable or .env.local:
# DEPLOYER_PK=0x...

# ─────────────────────────────────────────────────────────────
# Chain RPC Endpoints (optional overrides)
# ─────────────────────────────────────────────────────────────
# These are already configured in sdk/src/eth/chains.ts
# Only override if needed for specific testing

# HTTP_RPCS_56=your-custom-rpc-url
# HTTP_RPCS_1=your-custom-rpc-url
